rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated and email-verified accounts may access app data.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function isChatMember(chatId) {
      return signedIn()
        && chatExists(chatId)
        && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{userId} {
      // Exact UID lookup is needed to find a friend; profile list is private.
      allow get: if signedIn();
      allow list: if false;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'emailVerified', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.emailVerified == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /privateUsers/{userId} {
      // Phone number is readable only by its owner.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'phone', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /callRooms/{roomId} {
      // Only verified participants can read a room they have joined.
      allow get, list: if signedIn()
        && request.auth.uid in resource.data.members;

      // A verified user creates a room as its first participant.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'hostUid', 'members', 'callType', 'status',
          'maxParticipants', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.callType in ['audio', 'video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.maxParticipants == 5
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // A join adds only the joining verified user; a leave removes only self.
      // Membership can never exceed five participants.
      allow update: if signedIn()
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.maxParticipants == 5
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && request.resource.data.updatedAt is timestamp
        && (
          (
            !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.status == 'active'
          )
          ||
          (
            request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members)
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
          )
        );

      allow delete: if false;
    }

    match /chats/{chatId} {
      // A signed-in user may check whether a not-yet-created chat exists.
      // If the document exists, only its members may read it.
      allow get: if signedIn()
        && (
          !chatExists(chatId)
          || request.auth.uid in resource.data.members
        );

      // Queries must be constrained to chats containing the current user.
      allow list: if signedIn()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'members', 'type', 'createdAt'
        ])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.type == 'personal'
            && request.resource.data.members.size() == 2
            && !request.resource.data.keys().hasAny(['name'])
          )
          ||
          (
            request.resource.data.type == 'group'
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
          )
        );

      // Membership changes are disabled until a secure invite/leave flow exists.
      allow update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly([
            'sender', 'text', 'createdAt'
          ])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt is timestamp;

        allow update, delete: if false;
      }
    }
  }
}