rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Accept only Firebase-verified email accounts or Firebase Phone Auth accounts.
    function signedIn() {
      return request.auth != null
        && (
          (
            request.auth.token.keys().hasAny(['email_verified'])
            && request.auth.token.email_verified == true
          )
          || (
            request.auth.token.keys().hasAny(['phone_number'])
            && request.auth.token.phone_number is string
            && request.auth.token.phone_number.size() > 0
          )
        );
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function isChatMember(chatId) {
      return signedIn()
        && exists(chatPath(chatId))
        && request.auth.uid in get(chatPath(chatId)).data.members;
    }

    match /users/{userId} {
      // Public profile contains only UID and display name, never the email address.
      allow get: if signedIn();
      allow list: if false;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'emailVerified', 'phoneVerified', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.keys().hasAll(['emailVerified'])
            && request.resource.data.emailVerified == true
            && request.auth.token.keys().hasAny(['email_verified'])
            && request.auth.token.email_verified == true
            && !request.resource.data.keys().hasAny(['phoneVerified'])
          )
          ||
          (
            request.resource.data.keys().hasAll(['phoneVerified'])
            && request.resource.data.phoneVerified == true
            && request.auth.token.keys().hasAny(['phone_number'])
            && request.auth.token.phone_number is string
            && !request.resource.data.keys().hasAny(['emailVerified'])
          )
        );

      allow delete: if false;
    }

    match /privateUsers/{userId} {
      // Reserved for private account data; only its owner may read or write it.
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'phone', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /callRooms/{roomId} {
      // A room ID is a private invite: verified users may read one room by ID,
      // but no one may list/browse all rooms. Share the ID only with invitees.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'hostUid', 'members', 'callType', 'status',
          'maxParticipants', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.callType in ['audio', 'video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.maxParticipants == 5
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if signedIn()
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.callType == resource.data.callType
        && request.resource.data.maxParticipants == 5
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && request.resource.data.updatedAt is timestamp
        && (
          // Join: add only the caller, and only while the room is active.
          (
            !(request.auth.uid in resource.data.members)
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && resource.data.status in ['ringing', 'active']
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'status', 'updatedAt'])
          )
          ||
          // Leave while others remain: remove only the caller, keep status.
          (
            request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members)
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && request.resource.data.members.size() > 0
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'updatedAt'])
          )
          ||
          // Last participant leaves: mark the room ended.
          (
            request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members)
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && request.resource.data.members.size() == 0
            && request.resource.data.status == 'ended'
            && request.resource.data.endedAt is timestamp
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['members', 'status', 'endedAt', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    match /chats/{chatId} {
      // The app checks a deterministic chat ID before creating it.
      // Nonexistent IDs may be checked; existing chats are members-only.
      allow get: if signedIn()
        && (
          !exists(chatPath(chatId))
          || request.auth.uid in resource.data.members
        );

      // The app's array-contains query must be restricted to the current user.
      allow list: if signedIn()
        && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'members', 'type', 'createdAt'
        ])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.type == 'personal'
            && request.resource.data.members.size() == 2
            && !request.resource.data.keys().hasAny(['name'])
          )
          ||
          (
            request.resource.data.type == 'group'
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
          )
        );

      // Chat membership cannot be changed until a secure invite flow is built.
      allow update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly([
            'sender', 'text', 'createdAt'
          ])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt is timestamp;

        allow update, delete: if false;
      }
    }
  }
}